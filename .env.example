# ==========================================
# Akkhor - Environment Configuration Example
# ==========================================

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=AkkhorSchoolDb
DB_USERNAME=postgres
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# JWT Authentication
JWT_KEY=YOUR_JWT_SECRET_KEY
JWT_ISSUER=Akkhor
JWT_AUDIENCE=AkkhorUsers

# Backend API
API_URL=https://localhost:50268/api

# Frontend
FRONTEND_URL=http://localhost:4200
